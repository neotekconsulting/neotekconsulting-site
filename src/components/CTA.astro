---
import { site } from '@data/site';
export interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  eyebrow = 'Next step',
  title = 'Start with a Free AI Automation Feasibility Call',
  body = 'Talk through your workflows, repetitive tasks, and possible AI automation opportunities in up to 30 minutes.',
  primaryLabel = 'Book Free Call',
  primaryHref = site.bookingUrl,
  secondaryLabel = 'Download Free Guide',
  secondaryHref = '/10-ai-automations/'
} = Astro.props;
---
<section class="section">
  <div class="container">
    <div class="callout">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
      <p>{body}</p>
      <div class="button-row">
        <a class="button button--green" href={primaryHref}>{primaryLabel}</a>
        <a class="button button--secondary" href={secondaryHref}>{secondaryLabel}</a>
      </div>
    </div>
  </div>
</section>
