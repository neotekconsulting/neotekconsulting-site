---
import { site } from '@data/site';
---
<div class="card card--dark">
  <p class="eyebrow">NeoTek AI Early Access Program</p>
  <h2>10 launch spots available</h2>
  <p>Reserve priority access with a <strong>$200 Early Access Reservation Credit</strong>. Additional applicants will be placed into the next available spots.</p>
  <ul class="check-list">
    <li>Applies toward any NeoTek service</li>
    <li>Refundable within 30 days</li>
    <li>Expires after 6 months</li>
    <li>Priority scheduling and early access</li>
  </ul>
  <div class="button-row">
    <p class="muted">Reserve your spot with a refundable deposit using:</p>
    <p class="button-row" style="margin-top:0.5rem;">
    <a class="button button--green" href={site.squareUrl}>Square</a>
    <a class="button button--secondary" href={site.venmoUrl}>Venmo</a>
    <a class="button button--secondary" href={site.paypalUrl}>PayPal</a>
    </p>
  </div>
</div>
