---
import BaseLayout from '@layouts/BaseLayout.astro';
import CTA from '@components/CTA.astro';
---
<BaseLayout title="About" description="Learn about NeoTek Consulting and Jeff Johnson, Founder & Principal Consultant.">
  <section class="section">
    <div class="container two-column">
      <div>
        <p class="eyebrow">About NeoTek</p>
        <h1>Brand-first consulting backed by deep product and technology experience.</h1>
        <p class="lede">NeoTek Consulting helps businesses make AI automation understandable, practical, and useful for real operations.</p>
      </div>
      <div class="card card--dark">
        <h2>Founder & Principal Consultant</h2>
        <p>NeoTek is led by Jeff Johnson, Founder & Principal Consultant.</p>
        <p>Jeff brings decades of experience across technical product management, program management, web services, mobile applications, user experience, digital media, software systems, and enterprise-scale technology delivery.</p>
      </div>
    </div>
  </section>
  <section class="section section--soft">
    <div class="container two-column">
      <div>
        <p class="eyebrow">Experience</p>
        <h2>Enterprise-scale experience translated into practical automation.</h2>
        <p class="lede">Jeff's background includes work with Microsoft, Starbucks, Electronic Arts, Loudeye, T-Mobile, TrueBlue, and Fabric Worldwide. Company names are referenced as professional background, not NeoTek client claims.</p>
      </div>
      <div class="card">
        <ul class="check-list">
          <li>Technical product and program management</li>
          <li>Web service architecture and user interface design</li>
          <li>Mobile applications and customer-scale digital experiences</li>
          <li>Cloud, SaaS, data, metadata, and digital media systems</li>
          <li>Agile delivery and product ownership</li>
          <li>Certified Scrum Product Owner (CSPO)</li>
        </ul>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container two-column">
      <div>
        <p class="eyebrow">Patent background</p>
        <h2>Systems thinking across data, media, and online interaction.</h2>
        <p class="lede">Jeff's background includes named patent work related to online storefront reputation scoring, digital media metadata aggregation, and page-view/click-through tracking.</p>
      </div>
      <div class="card">
        <p class="muted">This experience informs NeoTek's practical approach to data, systems, customer interaction, and technology-enabled business workflows.</p>
      </div>
    </div>
  </section>
  <CTA />
</BaseLayout>
