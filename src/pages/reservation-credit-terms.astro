---
import BaseLayout from '@layouts/BaseLayout.astro';
import { site } from '@data/site';
---
<BaseLayout title="Reservation Credit Terms" description="Terms for the NeoTek $200 Early Access Reservation Credit." noindex={true}>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Early Access Terms</p>
      <h1>$200 Early Access Reservation Credit</h1>
      <p class="lede">These are starter terms and should be reviewed by qualified counsel before launch.</p>
      <div class="card">
        <h2>Summary</h2>
        <p>The $200 Early Access Reservation Credit reserves priority scheduling and early access to NeoTek services. It applies toward any NeoTek service, including an AI Readiness & Automation Assessment, pilot project, or approved support work.</p>
        <h2>Refund window</h2>
        <p>The reservation credit is refundable within 30 days of purchase.</p>
        <h2>Expiration</h2>
        <p>After the 30-day refund window, the credit remains available toward eligible NeoTek services and expires 6 months after purchase.</p>
        <h2>Availability</h2>
        <p>The initial NeoTek AI Early Access Program includes 10 launch spots. Additional applicants will be placed into the next available spots.</p>
        <h2>Contact</h2>
        <p>Questions can be sent to <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>
