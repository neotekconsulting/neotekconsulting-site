---
import BaseLayout from '@layouts/BaseLayout.astro';
import { site } from '@data/site';
---
<BaseLayout title="Privacy Policy" description="NeoTek Consulting privacy policy." noindex={true}>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Legal</p>
      <h1>Privacy Policy</h1>
      <p class="lede">This is starter privacy-policy copy and should be reviewed by qualified counsel before launch.</p>
      <div class="card">
        <h2>Information we collect</h2>
        <p>NeoTek Consulting may collect contact information you provide, such as your name, email address, phone number, business name, and information you submit through forms, scheduling links, or email.</p>
        <h2>How we use information</h2>
        <p>We use submitted information to respond to inquiries, provide requested resources, schedule consultations, deliver services, maintain business records, and improve our communications.</p>
        <h2>Lead magnets and email</h2>
        <p>If you request a guide or join an email list, we may send the requested resource and related follow-up messages. You can unsubscribe from marketing email at any time.</p>
        <h2>AI automation projects</h2>
        <p>For client projects, NeoTek defines project-specific data access, handling expectations, permissions, and human-review steps in written project terms or statements of work.</p>
        <h2>Contact</h2>
        <p>Questions can be sent to <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>
